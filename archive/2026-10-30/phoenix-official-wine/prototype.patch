diff --git a/app/Sources/HorizonXILauncher/Runner.swift b/app/Sources/HorizonXILauncher/Runner.swift
index e948b2f..a50c70f 100644
--- a/app/Sources/HorizonXILauncher/Runner.swift
+++ b/app/Sources/HorizonXILauncher/Runner.swift
@@ -1245,6 +1245,24 @@ final class Runner: ObservableObject {
         }
     }
 
+    func runPhoenixLauncher(_ install: Install) {
+        if refuseWhileBusy("Phoenix") { return }
+        let dev = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent()
+            .deletingLastPathComponent().appendingPathComponent("scripts/phoenix-launcher.sh")
+        guard let script = Bundle.main.url(forResource: "phoenix-launcher", withExtension: "sh")
+            ?? (FileManager.default.isExecutableFile(atPath: dev.path) ? dev : nil) else {
+            appendLine("!! Phoenix launcher helper is missing"); return
+        }
+        let root = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Downloads/FFXI-Phoenix")
+        beginBusy("Phoenix official launcher")
+        jobWine = .init(server: install.wineserver, prefix: root.appendingPathComponent("prefix"))
+        spawn(URL(fileURLWithPath: "/bin/zsh"), args: [script.path, install.wine.path, root.path],
+              env: [:], cwd: Self.scratchDir) { [weak self] code in
+            self?.busy = false
+            self?.reportFailure(code, "Phoenix did not open. See Downloads/FFXI-Phoenix/logs.")
+        }
+    }
+
     func runCatsEyeLauncher(_ gameInstall: Install, dataPath: String = "") {
