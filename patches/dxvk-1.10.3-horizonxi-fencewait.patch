+      kSleep, kSleepEx, kWaitSingle, kWaitSingleEx, kWaitMulti, kWaitMultiEx,
+      kSelect, kRecv, kWSAWaitMulti, kWSAEnumEvents, kWaitMsg, kNtDelay, kFrameLatency,
+      kNumWaitFns
+    };
+
+    static const char* const kWaitNames[kNumWaitFns] = {
+      "Sleep", "SleepEx", "WaitForSingleObject", "WaitForSingleObjectEx",
+      "WaitForMultipleObjects", "WaitForMultipleObjectsEx", "select", "recv",
+      "WSAWaitForMultipleEvents", "WSAEnumNetworkEvents", "MsgWaitForMultipleObjects",
+      "NtDelayExecution", "SyncFrameLatency" };
+
+    struct WaitProbe {
+      FILE* file = nullptr;
+      std::atomic<uint64_t> count[kNumWaitFns] = { };
+      std::atomic<uint64_t> nanos[kNumWaitFns] = { };
+      std::chrono::steady_clock::time_point tick;
+      uint64_t frames = 0;
+      bool hooked = false;
+
+      WaitProbe() {
+        const char* p = std::getenv("DXVK_WAIT_LOG");
+        if (p && *p)
+          file = std::fopen(p, "a");
+        if (file) {
+          std::fprintf(file, "fps,wall_ms,frame_user_ms,frame_kernel_ms");
+          for (size_t i = 0; i < kNumWaitFns; i++)
+              std::fprintf(file, ",%s_n,%s_ms,%s_mainn,%s_mainms",
+              kWaitNames[i], kWaitNames[i], kWaitNames[i], kWaitNames[i]);
+          std::fprintf(file, "\n");
+          std::fflush(file);
+        }
+        tick = std::chrono::steady_clock::now();
+      }
+
+      bool on() const { return file != nullptr; }
+
+      // The thread that calls Present is the frame thread; only its waits can cost frame rate.
+      // Clamping every thread's short sleeps moved 15 s of CPU and not one frame, because the
+      // sleeping was happening off the frame path -- so the counters are split by thread now.
+      std::atomic<uint32_t> presentThread = { 0 };
+      std::atomic<uint64_t> countMain[kNumWaitFns] = { };
+      std::atomic<uint64_t> nanosMain[kNumWaitFns] = { };
+
+      void add(WaitFn fn, std::chrono::steady_clock::time_point t0) {
+        auto dt = std::chrono::steady_clock::now() - t0;
+        uint64_t ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(dt).count());
+        count[fn].fetch_add(1, std::memory_order_relaxed);
+        nanos[fn].fetch_add(ns, std::memory_order_relaxed);
+        if (GetCurrentThreadId() == presentThread.load(std::memory_order_relaxed)) {
+          countMain[fn].fetch_add(1, std::memory_order_relaxed);
+          nanosMain[fn].fetch_add(ns, std::memory_order_relaxed);
+        }
+      }
+
+      // Frame-thread CPU accounting. The frame thread turned out to make no blocking calls at
+      // all, so the question became whether its ~77 ms per frame is spent executing or parked in
+      // the kernel. GetThreadTimes answers it directly: user + kernel time for this thread only,
+      // against the wall clock over the same second.
+      uint64_t prevUser = 0, prevKernel = 0;
+      bool haveTimes = false;
+
+      void frame() {
+        if (!file)
+          return;
+        frames += 1;
+        auto now = std::chrono::steady_clock::now();
+        double dt = std::chrono::duration<double>(now - tick).count();
+        if (dt < 1.0)
+          return;
+
+        double userMs = 0.0, kernelMs = 0.0;
+        FILETIME ftC, ftE, ftK, ftU;
+        if (GetThreadTimes(GetCurrentThread(), &ftC, &ftE, &ftK, &ftU)) {
+          auto to64 = [](const FILETIME& f) {
+            return (uint64_t(f.dwHighDateTime) << 32) | f.dwLowDateTime; };
+          uint64_t u = to64(ftU), k = to64(ftK);
+          if (haveTimes) {
+            userMs   = double(u - prevUser)   / 10000.0;   // 100 ns units
+            kernelMs = double(k - prevKernel) / 10000.0;
+          }
+          prevUser = u; prevKernel = k; haveTimes = true;
+        }
+
+        std::fprintf(file, "%.2f", double(frames) / dt);
+        std::fprintf(file, ",%.1f,%.1f,%.1f", dt * 1000.0, userMs, kernelMs);
+        for (size_t i = 0; i < kNumWaitFns; i++) {
+          uint64_t n  = count[i].exchange(0, std::memory_order_relaxed);
+          uint64_t ns = nanos[i].exchange(0, std::memory_order_relaxed);
+          uint64_t nm = countMain[i].exchange(0, std::memory_order_relaxed);
+          uint64_t nsm = nanosMain[i].exchange(0, std::memory_order_relaxed);
+          std::fprintf(file, ",%llu,%.2f,%llu,%.2f", (unsigned long long) n, double(ns) / 1.0e6,
+            (unsigned long long) nm, double(nsm) / 1.0e6);
+        }
+        std::fprintf(file, "\n");
+        std::fflush(file);
+        tick = now;
+        frames = 0;
+      }
+    };
+
+    static WaitProbe g_waitProbe;
+
+    // Sampling profiler (DXVK_SAMPLE_LOG=<path>).
+    //
+    // The frame thread runs flat out -- 1040 ms of user CPU per 1058 ms of wall clock -- so the
+    // question is no longer "what is it waiting for" but "what code is it running". A helper
+    // thread suspends the frame thread on a fixed interval, reads its instruction pointer, and
+    // attributes the sample to whichever module the address falls in. That is a real profile of
+    // translated 32-bit code, which the host-side tools cannot produce: `sample` cannot unwind
+    // through this stack and reports two meaningless addresses.
+    struct ModuleBucket {
+      char     name[64] = { };
+      uintptr_t lo = 0, hi = 0;
+      uint64_t hits = 0;
+    };
+
+    struct SampleProfiler {
+      FILE* file = nullptr;
+      HANDLE thread = nullptr;
+      std::atomic<bool> stop = { false };
+      ModuleBucket mods[64] = { };
+      size_t modCount = 0;
+      uint64_t unknown = 0, total = 0;
+
+      bool on() const { return file != nullptr; }
+
+      void addModule(const char* name) {
+        HMODULE m = GetModuleHandleA(name);
+        if (m == nullptr || modCount >= 64)
+          return;
+        auto base = reinterpret_cast<uint8_t*>(m);
+        auto dos  = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+        auto nt   = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+        auto& b = mods[modCount++];
+        std::snprintf(b.name, sizeof(b.name), "%s", name);
+        b.lo = uintptr_t(base);
+        b.hi = b.lo + nt->OptionalHeader.SizeOfImage;
+      }
+
+      // Per-symbol counts for the hot module. Knowing the time is in ntdll is not enough: a
+      // sample parked in NtWaitForSingleObject means the thread is blocked, one in the wow64
+      // transition thunk means it is paying per-call overhead, and those lead opposite ways.
+      // Resolved by walking the export table for the nearest exported address at or below the
+      // sampled instruction pointer -- no symbol server involved.
+      static constexpr size_t NumSyms = 24;
+      struct SymBucket { char name[64] = { }; uint64_t hits = 0; };
+      SymBucket syms[NumSyms] = { };
+      size_t symCount = 0;
+      HMODULE hotModule = nullptr;
+
+      const char* nearestExport(HMODULE mod, uintptr_t ip) {
+        auto base = reinterpret_cast<uint8_t*>(mod);
+        auto dos  = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+        auto nt   = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+        auto& dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+        if (dir.VirtualAddress == 0)
+          return nullptr;
+        auto exp = reinterpret_cast<IMAGE_EXPORT_DIRECTORY*>(base + dir.VirtualAddress);
+        auto funcs = reinterpret_cast<uint32_t*>(base + exp->AddressOfFunctions);
+        auto names = reinterpret_cast<uint32_t*>(base + exp->AddressOfNames);
+        auto ords  = reinterpret_cast<uint16_t*>(base + exp->AddressOfNameOrdinals);
+
+        uintptr_t bestAddr = 0;
+        const char* best = nullptr;
+        for (uint32_t i = 0; i < exp->NumberOfNames; i++) {
+          uintptr_t a = uintptr_t(base) + funcs[ords[i]];
+          if (a <= ip && a > bestAddr) {
+            bestAddr = a;
+            best = reinterpret_cast<const char*>(base + names[i]);
+          }
+        }
+        return best;
+      }
+
+      void countSym(const char* name) {
+        for (size_t i = 0; i < symCount; i++) {
+          if (std::strcmp(syms[i].name, name) == 0) {
+            syms[i].hits++;
+            return;
+          }
+        }
+        if (symCount < NumSyms) {
+          std::snprintf(syms[symCount].name, sizeof(syms[symCount].name), "%s", name);
+          syms[symCount].hits = 1;
+          symCount++;
+        }
+      }
+
+      static constexpr size_t NumOffsets = 16;
+      struct OffBucket { uintptr_t off = 0; uint64_t hits = 0; };
+      OffBucket offs[NumOffsets] = { };
+      size_t offCount = 0;
+
+      void countOffset(uintptr_t off) {
+        off &= ~uintptr_t(0x3F);              // 64-byte granularity: a function, not a line
+        for (size_t i = 0; i < offCount; i++) {
+          if (offs[i].off == off) {
+            offs[i].hits++;
+            return;
+          }
+        }
+        if (offCount < NumOffsets)
+          offs[offCount++] = { off, 1 };
+      }
+
+      void hit(uintptr_t ip) {
+        total++;
+        for (size_t i = 0; i < modCount; i++) {
+          if (ip >= mods[i].lo && ip < mods[i].hi) {
+            mods[i].hits++;
+            if (hotModule != nullptr && uintptr_t(hotModule) == mods[i].lo) {
+              const char* s = nearestExport(hotModule, ip);
+              countSym(s ? s : "<no-export>");
+              // Nearest-export naming is only as good as the export table: wine's ntdll has a
+              // great deal of unexported code, so an address in the wow64 transition path
+              // resolves to whichever export happens to sit below it. Raw offsets say which
+              // it really is -- compare them against the reported symbol's address.
+              countOffset(ip - mods[i].lo);
+            }
+            return;
+          }
+        }
+        unknown++;
+      }
+
+      void report() {
+        if (!file)
+          return;
+        std::fprintf(file, "total=%llu unknown=%llu", (unsigned long long) total,
+          (unsigned long long) unknown);
+        for (size_t i = 0; i < modCount; i++)
+          std::fprintf(file, " %s=%llu", mods[i].name, (unsigned long long) mods[i].hits);
+        for (size_t i = 0; i < symCount; i++)
+          std::fprintf(file, " |%s=%llu", syms[i].name, (unsigned long long) syms[i].hits);
+        for (size_t i = 0; i < offCount; i++)
+          std::fprintf(file, " @%llx=%llu", (unsigned long long) offs[i].off,
+            (unsigned long long) offs[i].hits);
+        // The reference point for reading those offsets.
+        if (hotModule != nullptr) {
+          void* nd = (void*) GetProcAddress(hotModule, "NtDelayExecution");
+          if (nd)
+            std::fprintf(file, " NtDelayExecution@%llx",
+              (unsigned long long) (uintptr_t(nd) - uintptr_t(hotModule)));
+        }
+        std::fprintf(file, "\n");
+        std::fflush(file);
+        for (size_t i = 0; i < modCount; i++)
+          mods[i].hits = 0;
+        symCount = 0;
+        offCount = 0;
+        unknown = total = 0;
+      }
+    };
+
+    static SampleProfiler g_profiler;
+
+    static DWORD WINAPI SampleThreadProc(void* param) {
+      HANDLE target = reinterpret_cast<HANDLE>(param);
+      auto tick = std::chrono::steady_clock::now();
+      while (!g_profiler.stop.load(std::memory_order_relaxed)) {
+        if (SuspendThread(target) != DWORD(-1)) {
+          CONTEXT ctx = { };
+          ctx.ContextFlags = CONTEXT_CONTROL;
+          if (GetThreadContext(target, &ctx)) {
+#if defined(_WIN64)
+            g_profiler.hit(uintptr_t(ctx.Rip));
+#else
+            g_profiler.hit(uintptr_t(ctx.Eip));
+#endif
+          }
+          ResumeThread(target);
+        }
+        Sleep(1);
+        auto now = std::chrono::steady_clock::now();
+        if (std::chrono::duration<double>(now - tick).count() >= 1.0) {
+          g_profiler.report();
+          tick = now;
+        }
+      }
+      return 0;
+    }
+
+    static void StartProfiler() {
+      if (g_profiler.thread != nullptr)
+        return;
+      const char* p = std::getenv("DXVK_SAMPLE_LOG");
+      if (p == nullptr || *p == '\0')
+        return;
+      // Only start once FFXiMain is mapped, so its address range is known.
+      if (GetModuleHandleA("FFXiMain.dll") == nullptr)
+        return;
+      g_profiler.file = std::fopen(p, "a");
+      if (g_profiler.file == nullptr)
+        return;
+      for (const char* m : { "FFXiMain.dll", "d3d8.dll", "d3d9.dll", "polcore.dll",
