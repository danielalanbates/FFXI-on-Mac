+  // DXVK_DRAW_PROBE, which crashes the client at 4K with the sidecar attached.
+  enum StallSite { kStMapWait, kStMapBlocked, kStSyncCs, kStNumSites };
+  static const char* kStallSiteNames[kStNumSites] = { "map_wait", "map_blocked", "sync_cs" };
+
+  struct StallProbe {
+    FILE* file = nullptr;
+    uint64_t ns[kStNumSites] = { };
+    uint64_t hits[kStNumSites] = { };
+    std::chrono::steady_clock::time_point tick;
+    uint64_t frames = 0;
