+    StallProbe() {
+      const char* p = std::getenv("DXVK_STALL_LOG");
+      if (p && *p) file = std::fopen(p, "a");
+      if (file) {
+        std::fprintf(file, "fps");
+        for (size_t i = 0; i < kStNumSites; i++)
+          std::fprintf(file, ",%s_ms,%s_n", kStallSiteNames[i], kStallSiteNames[i]);
+        std::fprintf(file, "\n");
+        std::fflush(file);
+      }
+      tick = std::chrono::steady_clock::now();
+    }
+    bool on() const { return file != nullptr; }
+    void add(StallSite s, std::chrono::steady_clock::time_point t0) {
+      if (!file) return;
+      ns[s] += std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - t0).count();
+      hits[s]++;
+    }
+    void frame() {
+      if (!file) return;
+      frames++;
+      auto now = std::chrono::steady_clock::now();
+      double dt = std::chrono::duration<double>(now - tick).count();
+      if (dt < 1.0) return;
+      std::fprintf(file, "%.2f", double(frames) / dt);
+      for (size_t i = 0; i < kStNumSites; i++) {
+        std::fprintf(file, ",%.2f,%.1f",
+                     double(ns[i]) / 1.0e6 / double(frames), double(hits[i]) / double(frames));
+        ns[i] = 0; hits[i] = 0;
+      }
+      std::fprintf(file, "\n");
+      std::fflush(file);
+      tick = now; frames = 0;
+    }
