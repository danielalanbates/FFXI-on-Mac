+  // binding constraint long before the renderer is, so the cap has to be measurable and
+  // adjustable to tell "we are slow" apart from "the client is waiting on purpose". Same
+  // signature and pointer walk Ashita's own `fps` addon uses; done here because Ashita's plugin
+  // host does not load in this install. No effect unless the environment variable is set.
+  namespace {
+    bool ApplyFfxiFpsDivisor() {
+      const char* v = std::getenv("FFXI_FPS_DIVISOR");
+      if (v == nullptr || *v == '\0')
