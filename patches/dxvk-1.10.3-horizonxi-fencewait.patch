+    // ws2_32 entry points, timed the same way. Their signatures differ but every one of them is
+    // called through a pointer whose arguments we never touch, so a cdecl-shaped forward with the
+    // right stack size is all that is needed -- declared with the real prototypes to keep the
+    // 32-bit stdcall stack balanced.
+    using PfnSelect   = int (WINAPI*)(int, void*, void*, void*, const void*);
+    using PfnRecv     = int (WINAPI*)(UINT_PTR, char*, int, int);
+    using PfnWSAWait  = DWORD (WINAPI*)(DWORD, const HANDLE*, BOOL, DWORD, BOOL);
+    using PfnWSAEnum  = int (WINAPI*)(UINT_PTR, HANDLE, void*);
+
+    static int WINAPI HookSelect(int n, void* r, void* w, void* e, const void* tv) {
+      auto t0 = std::chrono::steady_clock::now();
+      int rc = reinterpret_cast<PfnSelect>(g_orig[kSelect])(n, r, w, e, tv);
+      g_waitProbe.add(kSelect, t0);
+      return rc;
+    }
+    static int WINAPI HookRecv(UINT_PTR s, char* buf, int len, int flags) {
+      auto t0 = std::chrono::steady_clock::now();
+      int rc = reinterpret_cast<PfnRecv>(g_orig[kRecv])(s, buf, len, flags);
+      g_waitProbe.add(kRecv, t0);
+      return rc;
+    }
+    static DWORD WINAPI HookWSAWait(DWORD n, const HANDLE* h, BOOL all, DWORD ms, BOOL alert) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD rc = reinterpret_cast<PfnWSAWait>(g_orig[kWSAWaitMulti])(n, h, all, ms, alert);
+      g_waitProbe.add(kWSAWaitMulti, t0);
+      return rc;
+    }
+    static int WINAPI HookWSAEnum(UINT_PTR s, HANDLE ev, void* out) {
+      auto t0 = std::chrono::steady_clock::now();
+      int rc = reinterpret_cast<PfnWSAEnum>(g_orig[kWSAEnumEvents])(s, ev, out);
+      g_waitProbe.add(kWSAEnumEvents, t0);
+      return rc;
+    }
+
+    struct WaitHookSpec { const char* dll; const char* name; void* thunk; };
+
+    // NtDelayExecution is where the sleeping actually shows up: 72% of the frame thread's
+    // samples. Sleep() in kernel32 forwards to it, but so does whatever else in the chain is
+    // pacing the client, which is why hooking Sleep alone changed nothing on the frame path.
+    // Interval is a LARGE_INTEGER in 100 ns units, negative meaning relative.
+    using PfnNtDelay = LONG (WINAPI*)(BOOLEAN, LARGE_INTEGER*);
+
+    static LONG WINAPI HookNtDelay(BOOLEAN alertable, LARGE_INTEGER* interval) {
+      auto t0 = std::chrono::steady_clock::now();
+      LARGE_INTEGER zero = { };
+      LARGE_INTEGER* use = interval;
+      if (g_sleepClamp != 0 && interval != nullptr && interval->QuadPart < 0) {
+        // Relative delay, in 100 ns units. Anything at or under the clamp becomes a plain
+        // yield, which costs microseconds instead of a timer arming at this wine's ~1.25 ms
+        // granularity.
+        int64_t ms = -interval->QuadPart / 10000;
+        if (ms <= int64_t(g_sleepClamp))
+          use = &zero;
+      }
+      LONG r = reinterpret_cast<PfnNtDelay>(g_orig[kNtDelay])(alertable, use);
+      g_waitProbe.add(kNtDelay, t0);
+      return r;
+    }
+
+    static const WaitHookSpec kWaitHooks[kNumWaitFns] = {
+      { "kernel32.dll", "Sleep",                     (void*) &HookSleep        },
+      { "kernel32.dll", "SleepEx",                   (void*) &HookSleepEx      },
+      { "kernel32.dll", "WaitForSingleObject",       (void*) &HookWaitSingle   },
+      { "kernel32.dll", "WaitForSingleObjectEx",     (void*) &HookWaitSingleEx },
+      { "kernel32.dll", "WaitForMultipleObjects",    (void*) &HookWaitMulti    },
+      { "kernel32.dll", "WaitForMultipleObjectsEx",  (void*) &HookWaitMultiEx  },
+      { "ws2_32.dll",   "select",                    (void*) &HookSelect       },
+      { "ws2_32.dll",   "recv",                      (void*) &HookRecv         },
+      { "ws2_32.dll",   "WSAWaitForMultipleEvents",  (void*) &HookWSAWait      },
+      { "ws2_32.dll",   "WSAEnumNetworkEvents",      (void*) &HookWSAEnum      },
+      { "user32.dll",   "MsgWaitForMultipleObjects", (void*) &HookWaitMsg      },
+      { "ntdll.dll",    "NtDelayExecution",          (void*) &HookNtDelay      },
+      // Timed in place rather than hooked -- it is our own function, not an import.
+      { "",             "",                          nullptr                   },
+    };
+
+    // Rewrite one module's import table. Walks every imported DLL's thunk array and swaps the
+    // resolved address for ours wherever the name matches, which is the least invasive way to
+    // intercept a call in a module we do not control -- no code is patched.
+    static uint32_t HookImportsOf(HMODULE mod) {
+      if (mod == nullptr)
+        return 0;
+      auto base = reinterpret_cast<uint8_t*>(mod);
+      auto dos  = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+      if (dos->e_magic != IMAGE_DOS_SIGNATURE)
+        return 0;
+      auto nt = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+      if (nt->Signature != IMAGE_NT_SIGNATURE)
+        return 0;
+      auto& dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+      if (dir.VirtualAddress == 0)
+        return 0;
+
+      uint32_t patched = 0;
+      auto desc = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base + dir.VirtualAddress);
+      for (; desc->Name; desc++) {
+        const char* dllName = reinterpret_cast<const char*>(base + desc->Name);
+        if (desc->OriginalFirstThunk == 0 || desc->FirstThunk == 0)
+          continue;
+        auto names = reinterpret_cast<IMAGE_THUNK_DATA*>(base + desc->OriginalFirstThunk);
+        auto addrs = reinterpret_cast<IMAGE_THUNK_DATA*>(base + desc->FirstThunk);
+
+        for (; names->u1.AddressOfData; names++, addrs++) {
+          if (names->u1.Ordinal & IMAGE_ORDINAL_FLAG)
+            continue;
+          auto imp = reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base + names->u1.AddressOfData);
+
+          for (size_t i = 0; i < kNumWaitFns; i++) {
+            if (std::strcmp(reinterpret_cast<const char*>(imp->Name), kWaitHooks[i].name) != 0)
+              continue;
+            if (_stricmp(dllName, kWaitHooks[i].dll) != 0)
+              continue;
