   }
   
   
+  // DXVK_QUEUE_LOG=<path>: one line per second from the retirement thread — how many
+  // submissions retired, how much wall time their fence syncs took, and the worst single
+  // sync. Distinguishes "GPU is actually busy" from "completion notifications stack up",
+  // which is the open question behind the 26 ms visibility-readback stall (docs/MAX4K.md).
+  namespace {
+    struct QueueLog {
+      FILE* file = nullptr;
+      std::chrono::steady_clock::time_point tick = std::chrono::steady_clock::now();
+      uint64_t retired = 0, syncUs = 0, maxUs = 0, notifyUs = 0;
+      QueueLog() {
+        if (const char* p = std::getenv("DXVK_QUEUE_LOG"))
+          if (*p) file = std::fopen(p, "a");
+      }
+      void add(uint64_t sUs, uint64_t nUs) {
+        if (!file) return;
+        retired++; syncUs += sUs; notifyUs += nUs; if (sUs > maxUs) maxUs = sUs;
+        auto now = std::chrono::steady_clock::now();
+        if (now - tick >= std::chrono::seconds(1)) {
+          std::fprintf(file, "retired=%llu sync_ms=%.1f max_ms=%.1f notify_ms=%.1f\n",
+            (unsigned long long)retired, syncUs / 1000.0, maxUs / 1000.0, notifyUs / 1000.0);
+          std::fflush(file);
+          tick = now; retired = 0; syncUs = 0; maxUs = 0; notifyUs = 0;
+        }
+      }
+    };
+    QueueLog g_queueLog;
+  }
+
