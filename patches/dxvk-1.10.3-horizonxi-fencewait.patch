+namespace {
+  // Batching-headroom probe (DXVK_BATCH_PROBE=1). FFXI submits thousands of tiny draws per
+  // frame and the stack is bound by draw submission cost, not by the GPU. The question that
+  // decides whether an instancing/merging layer is worth building is: how many of those draws
+  // actually share pipeline state and textures? If N draws collapse into a handful of state
+  // groups, merging them is a large win. If nearly every draw is its own group, it is not.
+  struct BatchProbe {
+    uint64_t draws = 0;
+    std::set<uint64_t> groups;         // distinct (shaders, textures, decl) signatures
+    std::set<uint64_t> texGroups;      // distinct texture-0 bindings alone
+    std::set<uint64_t> fullGroups;     // signature + world transform + FF render states
+    std::set<uint64_t> meshGroups;     // signature + the actual mesh (vertex+index buffer)
+    uint64_t instanceable = 0;         // draws that repeat a mesh already seen this frame
+    uint64_t lastMesh = 0;             // previous draw's mesh+state, for run detection
+    uint64_t runMerges = 0;            // draws that continue the immediately preceding run
+    uint64_t opaqueRunMerges = 0;      // same, but only where alpha blending is off
+    bool     lastBlend = false;
+    uint64_t blendEnabled = 0;         // draws with ALPHABLENDENABLE set
+    uint64_t blendIsOpaque = 0;        // ...of those, ones whose factors are ONE/ZERO
+    uint64_t effOpaqueRun = 0;         // consecutive repeats that are *effectively* opaque
+    uint64_t frames = 0;
+    FILE* out = nullptr;
+    bool enabled = std::getenv("DXVK_BATCH_PROBE") != nullptr;
+    void note(uint64_t sig, uint64_t tex, uint64_t full, uint64_t mesh, bool blend, bool opaqueFactors) {
+      if (!enabled) return;
+      draws++; groups.insert(sig); texGroups.insert(tex); fullGroups.insert(full);
+      if (!meshGroups.insert(mesh).second) instanceable++;   // this mesh+state seen before
+      // A *consecutive* repeat is what a simple batcher can capture without reordering draws.
+      if (blend) { blendEnabled++; if (opaqueFactors) blendIsOpaque++; }
+      // "Effectively opaque" = blending off, or on but with ONE/ZERO factors, which writes the
+      // source colour straight out. Those are order-independent and safe to reorder/batch.
+      const bool effOpaque = !blend || opaqueFactors;
+      if (draws > 1 && mesh == lastMesh) {
+        runMerges++;
+        if (!blend && !lastBlend) opaqueRunMerges++;
+        if (effOpaque) effOpaqueRun++;
+      }
+      lastMesh = mesh; lastBlend = blend;
+    }
+    void frame() {
+      if (!enabled) return;
+      frames++;
+      if (draws == 0) return;
+      if (!out) out = fopen("/tmp/dxvk-batch-probe.log", "w");
+      if (out && (frames % 30) == 0) {
+        fprintf(out, "frame %llu draws %llu stategroups %zu texgroups %zu fullgroups %zu meshgroups %zu instanceable %llu runmerges %llu opaquerun %llu blend %llu blendopaque %llu effopaquerun %llu  merge_ratio %.1fx  trivial_merge %.1fx  instancing_ratio %.1fx\n",
+                (unsigned long long)frames, (unsigned long long)draws,
+                groups.size(), texGroups.size(), fullGroups.size(), meshGroups.size(),
+                (unsigned long long)instanceable,
+                (unsigned long long)runMerges, (unsigned long long)opaqueRunMerges,
+                (unsigned long long)blendEnabled, (unsigned long long)blendIsOpaque,
+                (unsigned long long)effOpaqueRun,
+                groups.empty() ? 0.0 : double(draws) / double(groups.size()),
+                fullGroups.empty() ? 0.0 : double(draws) / double(fullGroups.size()),
+                meshGroups.empty() ? 0.0 : double(draws) / double(meshGroups.size()));
+        fflush(out);
+      }
+      draws = 0; instanceable = 0; runMerges = 0; opaqueRunMerges = 0; blendEnabled = 0; blendIsOpaque = 0; effOpaqueRun = 0; lastMesh = 0; groups.clear(); texGroups.clear(); fullGroups.clear(); meshGroups.clear();
+    }
+  };
+  static BatchProbe g_batchProbe;
+}
+
 namespace dxvk {
 
+namespace {
+  // Flush attribution (DXVK_FLUSH_LOG=<path>).
+  //
+  // In-world FFXI submits ~33 command buffers per frame; character select, at a comparable draw
+  // count, submits ~6. Each submit is a command-buffer commit on Metal, so knowing *which*
+  // D3D9 entry point is forcing them is the difference between guessing and fixing.
+  enum FlushSite { kFsUpdateTex, kFsSetRT, kFsSetDS, kFsEndScene, kFsMisc1, kFsMisc2,
+                   kFsQueryEnd, kFsNumSites };
+  static const char* kFlushSiteNames[kFsNumSites] = {
+    "UpdateTexture", "SetRenderTarget", "SetDepthStencil", "EndScene",
+    "misc4475", "misc5158", "QueryEnd" };
+
+  struct FlushProbe {
+    FILE* file = nullptr;
+    uint64_t calls[kFsNumSites] = { };
+    uint64_t flushes[kFsNumSites] = { };
+    std::chrono::steady_clock::time_point tick;
+    uint64_t frames = 0;
+
+    FlushProbe() {
+      const char* p = std::getenv("DXVK_FLUSH_LOG");
+      if (p && *p) file = std::fopen(p, "a");
+      if (file) {
+        std::fprintf(file, "fps");
+        for (size_t i = 0; i < kFsNumSites; i++)
+          std::fprintf(file, ",%s_calls,%s_flushes", kFlushSiteNames[i], kFlushSiteNames[i]);
+        std::fprintf(file, "\n");
+        std::fflush(file);
+      }
+      tick = std::chrono::steady_clock::now();
+    }
+    bool on() const { return file != nullptr; }
+    void call(FlushSite s) { if (file) calls[s]++; }
+    void flushed(FlushSite s) { if (file) flushes[s]++; }
+    void frame() {
+      if (!file) return;
+      frames++;
+      auto now = std::chrono::steady_clock::now();
+      double dt = std::chrono::duration<double>(now - tick).count();
+      if (dt < 1.0) return;
