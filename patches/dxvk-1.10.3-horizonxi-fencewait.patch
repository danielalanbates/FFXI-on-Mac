+      HANDLE dup = nullptr;
+      DuplicateHandle(GetCurrentProcess(), GetCurrentThread(),
+                      GetCurrentProcess(), &dup, 0, FALSE, DUPLICATE_SAME_ACCESS);
+      g_profiler.thread = CreateThread(nullptr, 0, &SampleThreadProc, dup, 0, nullptr);
+      Logger::info(str::format("sample profiler started over ", g_profiler.modCount, " modules"));
+    }
+
+    // The thunks. Each records elapsed time against its slot and forwards unchanged.
+    using PfnSleep       = void  (WINAPI*)(DWORD);
+    using PfnSleepEx     = DWORD (WINAPI*)(DWORD, BOOL);
+    using PfnWaitSingle  = DWORD (WINAPI*)(HANDLE, DWORD);
+    using PfnWaitSingleEx= DWORD (WINAPI*)(HANDLE, DWORD, BOOL);
+    using PfnWaitMulti   = DWORD (WINAPI*)(DWORD, const HANDLE*, BOOL, DWORD);
+    using PfnWaitMultiEx = DWORD (WINAPI*)(DWORD, const HANDLE*, BOOL, DWORD, BOOL);
+    using PfnWaitMsg     = DWORD (WINAPI*)(DWORD, const HANDLE*, BOOL, DWORD, DWORD);
+    using PfnGeneric     = int   (WINAPI*)(void);
+
+    static void*  g_orig[kNumWaitFns] = { };
+
+    // Short-sleep clamp (FFXI_SLEEP_CLAMP=<ms>, unset = leave alone).
+    //
+    // The client polls with ~200 Sleep() calls per frame. On Windows a 1 ms sleep costs about
+    // that; under this wine it costs 1.25 ms, and 200 of them is 250 ms of wall clock spent
+    // doing nothing -- which is the whole of the in-world stall. Requests at or below the clamp
+    // become Sleep(0), which yields the timeslice without arming a timer (measured at 4 us).
+    // The loop then makes progress at CPU speed. Only sleeps *shorter* than the clamp are
+    // touched, so any genuine long wait is left exactly as the client asked for it.
+    static DWORD g_sleepClamp = 0;
+
+    static void WINAPI HookSleep(DWORD ms) {
+      auto t0 = std::chrono::steady_clock::now();
+      reinterpret_cast<PfnSleep>(g_orig[kSleep])(ms <= g_sleepClamp ? 0 : ms);
+      g_waitProbe.add(kSleep, t0);
+    }
+    static DWORD WINAPI HookSleepEx(DWORD ms, BOOL alert) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnSleepEx>(g_orig[kSleepEx])(ms, alert);
+      g_waitProbe.add(kSleepEx, t0);
+      return r;
+    }
+    static DWORD WINAPI HookWaitSingle(HANDLE h, DWORD ms) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnWaitSingle>(g_orig[kWaitSingle])(h, ms);
+      g_waitProbe.add(kWaitSingle, t0);
+      return r;
+    }
+    static DWORD WINAPI HookWaitSingleEx(HANDLE h, DWORD ms, BOOL alert) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnWaitSingleEx>(g_orig[kWaitSingleEx])(h, ms, alert);
+      g_waitProbe.add(kWaitSingleEx, t0);
+      return r;
+    }
+    static DWORD WINAPI HookWaitMulti(DWORD n, const HANDLE* h, BOOL all, DWORD ms) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnWaitMulti>(g_orig[kWaitMulti])(n, h, all, ms);
+      g_waitProbe.add(kWaitMulti, t0);
+      return r;
+    }
+    static DWORD WINAPI HookWaitMultiEx(DWORD n, const HANDLE* h, BOOL all, DWORD ms, BOOL alert) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnWaitMultiEx>(g_orig[kWaitMultiEx])(n, h, all, ms, alert);
+      g_waitProbe.add(kWaitMultiEx, t0);
+      return r;
+    }
+    static DWORD WINAPI HookWaitMsg(DWORD n, const HANDLE* h, BOOL all, DWORD ms, DWORD mask) {
+      auto t0 = std::chrono::steady_clock::now();
+      DWORD r = reinterpret_cast<PfnWaitMsg>(g_orig[kWaitMsg])(n, h, all, ms, mask);
+      g_waitProbe.add(kWaitMsg, t0);
+      return r;
+    }
