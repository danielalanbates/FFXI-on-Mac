.DS_Store
*.log
app/.build/
.build/
app/build/
dist/

# never commit a boot profile — it holds the account name and password.
# Ashita v4 spells them .ini, v3 (Eden, ValhallaXI, FFEra) spells them .xml.
config/boot/*.ini
config/boot/*.xml
*.boot.xml
*.premetal
sweep-out/

# harness output
scripts/shots/
*.vkbak

# benchmark harness output (screenshots, per-run JSON, wine logs)
scripts/harness/results/
scripts/harness/shots/

# archived .app builds are binaries, not source
archive/app-builds/

# personal / local-server secrets (never commit even if copied into the tree)
accounts.json
**/.dbpass
.dbpass
*.dbpass
**/accounts.json
*.bak
*.macos26.bak

# secrets and signing material (notary API keys are AuthKey_<id>.p8)
.env
.env.*
*api-key*
AuthKey_*.p8
*.p8
*.p12
*.pem
*.keychain-db
# boot profiles anywhere in the tree, not only at the root (they hold --user/--pass)
**/config/boot/*.ini
**/config/boot/*.xml
# repo-level boot profiles; addons/lsb2.ini.example is the template for twoclient.py
addons/*.ini
# per-launch diagnostics, chat/command channels (chat carries character names), ImGui layout
last-spawn*.txt
**/cmdpipe/cmd.txt
**/cmdpipe/chat.txt
imgui.ini

# Personal achievement snapshots and optional local OCR diagnostics.
retroachievements.json
retroachievements-snapshots.json
*.personal.json
ocr-captures/
screen-captures/
